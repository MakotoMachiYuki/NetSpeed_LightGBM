# =============================================================================
# NetSpeed LightGBM – Example Environment Configuration
# Copy this file to `.env` and fill in your private API keys before running.
# =============================================================================

CARTO_API_KEY=your_carto_api_key_here
CARTO_BASEMAP_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
CLOUDFLARE_SPEED_URL=https://speed.cloudflare.com
SPEEDTEST_DATA_MAX_MB=60
SPEEDTEST_DL_MAX_MB=30
SPEEDTEST_UL_MAX_MB=30
DATA_PATH=Dataset/ookla_indonesia_only.parquet
MODEL_BUNDLE_PATH=Dataset/lightgbm_ookla_bundle.pkl
TEST_SIZE=0.30
RANDOM_STATE=727
MAP_SAMPLE_PER_YEAR=15000
LOCAL_SAMPLE_SIZE=5000
DEFAULT_LAT=-6.2088
DEFAULT_LON=106.8456
